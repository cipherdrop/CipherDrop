
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="dark">
  <title>CipherDrop — Private Zcash Handoff</title>

  <style>
    * {
      box-sizing: border-box;
    }

    :root {
      --bg: #0b0f14;
      --panel: #111827;
      --green: #60a5fa;
      --green-soft: #93c5fd;
      --green-dim: #334155;
      --line: rgba(0, 255, 65, 0.28);
      --line-soft: rgba(0, 255, 65, 0.12);
      --text: #e7eee9;
      --muted: #c7d0c9;
      --dim: #9aa69d;
      --danger: #ff6262;
    }

    html {
      background: var(--bg);
    }

    body {
      margin: 0;
      min-height: 100vh;
      overflow-x: hidden;
      background: var(--bg);
      color: var(--text);
      font-family:
        "Courier New",
        Courier,
        monospace;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      opacity: 0.28;
      background-image:
        radial-gradient(
          circle,
          rgba(0, 255, 65, 0.24) 1px,
          transparent 1px
        );
      background-size: 22px 22px;
      mask-image:
        linear-gradient(
          to bottom,
          black 0%,
          rgba(0,0,0,.8) 65%,
          transparent 100%
        );
    }

    body::after {
      content: "";
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background:
        radial-gradient(
          circle at 50% 20%,
          rgba(0,255,65,.035),
          transparent 40%
        );
    }

    button,
    input,
    textarea {
      font: inherit;
    }

    .shell {
      position: relative;
      z-index: 1;
      width: min(1160px, calc(100% - 40px));
      margin: 0 auto;
    }

    /* TOP NAV */

    header {
      position: relative;
      z-index: 2;
      padding-top: 24px;
    }

    .nav {
      min-height: 58px;
      padding: 0 20px;
      border: 1px solid var(--green-dim);
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(2, 6, 3, 0.88);
      box-shadow:
        0 0 24px rgba(0,255,65,.025),
        inset 0 0 20px rgba(0,255,65,.012);
    }

    .brand {
      color: var(--green);
      font-size: 14px;
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    .cursor {
      display: inline-block;
      width: 7px;
      height: 14px;
      margin-left: 3px;
      vertical-align: -2px;
      background: var(--green);
      animation: blink 1.1s steps(1) infinite;
    }

    @keyframes blink {
      50% {
        opacity: 0;
      }
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 18px;
      color: var(--green-soft);
      font-size: 12px;
      text-transform: uppercase;
    }

    .network {
      display: flex;
      align-items: center;
      gap: 7px;
    }

    .network-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 9px var(--green);
    }

    /* MAIN */

    main {
      position: relative;
      z-index: 1;
      padding: 32px 0 28px;
    }

    .section-label {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 15px;
      color: var(--green);
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .section-label::after {
      content: "";
      width: 150px;
      height: 1px;
      background: linear-gradient(
        90deg,
        var(--green-dim),
        transparent
      );
    }

    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 310px;
      gap: 50px;
      align-items: end;
      margin-bottom: 27px;
    }

    h1 {
      margin: 0;
      max-width: 700px;
      color: #f1f5f2;
      font-family:
        Arial,
        Helvetica,
        sans-serif;
      font-size: clamp(36px, 5vw, 58px);
      line-height: .93;
      letter-spacing: -0.055em;
      text-transform: uppercase;
      font-weight: 900;
    }

    h1 span {
      color: var(--green);
    }

    .hero-copy {
      padding-bottom: 3px;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.75;
    }

    .hero-copy strong {
      color: var(--green-soft);
      font-weight: 500;
    }

    .hero-code {
      display: block;
      margin-bottom: 8px;
      color: var(--green);
      font-size: 12px;
      text-transform: uppercase;
    }

    /* WORKSPACE */

    .workspace {
      display: grid;
      grid-template-columns: 155px minmax(0, 1fr);
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      background: rgba(2, 5, 3, 0.58);
    }

    .step-column {
      padding: 23px 20px;
      border-right: 1px solid var(--line);
    }

    .step-number {
      margin-bottom: 55px;
      color: var(--green);
      font-size: 31px;
      line-height: 1;
    }

    .step-label {
      color: var(--green);
      font-size: 12px;
      line-height: 1.6;
      text-transform: uppercase;
    }

    .step-label span {
      display: block;
      margin-top: 7px;
      color: var(--dim);
      font-size: 13px;
    }

    /* FORM */

    .form-area {
      padding: 21px 25px 23px;
    }

    .form-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 19px;
    }

    .form-title {
      color: var(--green);
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
    }

    .encrypted {
      color: var(--dim);
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: .05em;
    }

    .encrypted::before {
      content: "[ ";
      color: var(--green-dim);
    }

    .encrypted::after {
      content: " ]";
      color: var(--green-dim);
    }

    .form-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.6fr) minmax(320px, 1fr);
      gap: 22px;
    }

    .field {
      margin-bottom: 16px;
    }

    .field-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 14px;
      margin-bottom: 7px;
    }

    .field-label {
      color: #cfd8d1;
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
    }

    .field-meta {
      color: var(--dim);
      font-size: 13px;
      text-transform: uppercase;
    }

    textarea,
    input[type="number"] {
      width: 100%;
      border: 1px solid var(--line);
      border-radius: 0;
      outline: none;
      background: rgba(0, 4, 1, .88);
      color: var(--green);
      transition:
        border-color 150ms ease,
        box-shadow 150ms ease;
    }

    textarea {
      min-height: 138px;
      padding: 14px;
      resize: vertical;
      font-size: 13px;
      line-height: 1.6;
    }

    textarea::placeholder,
    input::placeholder {
      color: #35473a;
    }

    textarea:focus,
    input[type="number"]:focus {
      border-color: var(--green);
      box-shadow:
        0 0 0 1px rgba(0,255,65,.08),
        inset 0 0 18px rgba(0,255,65,.025);
    }

    .side-controls {
      display: flex;
      flex-direction: column;
    }

    .price-wrap {
      position: relative;
    }

    .price-wrap input {
      height: 47px;
      padding: 0 62px 0 13px;
      font-size: 13px;
      font-weight: 700;
    }

    .currency {
      position: absolute;
      right: 13px;
      top: 50%;
      transform: translateY(-50%);
      padding-left: 11px;
      border-left: 1px solid var(--line);
      color: var(--green);
      font-size: 12px;
      font-weight: 700;
    }

    /* BURN */

    .burn-option {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      margin: 0 0 16px;
      padding: 12px;
      border: 1px solid var(--line-soft);
      cursor: pointer;
      background: rgba(0,255,65,.012);
    }

    .burn-option:hover {
      border-color: var(--line);
    }

    .burn-option input {
      width: 13px;
      height: 13px;
      margin: 1px 0 0;
      accent-color: var(--green);
      flex: 0 0 auto;
    }

    .burn-title {
      display: block;
      margin-bottom: 4px;
      color: #c8d1ca;
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
    }

    .burn-desc {
      display: block;
      color: var(--dim);
      font-size: 13px;
      line-height: 1.5;
    }

    /* BUTTON */

    .submit {
      width: 100%;
      min-height: 47px;
      margin-top: auto;
      border: 1px solid var(--green);
      border-radius: 0;
      background: var(--green);
      color: #001604;
      font-size: 12px;
      font-weight: 900;
      text-transform: uppercase;
      cursor: pointer;
      transition: all 130ms ease;
    }

    .submit::before {
      content: "[ ";
    }

    .submit::after {
      content: " ]";
    }

    .submit:hover {
      background: transparent;
      color: var(--green);
      box-shadow:
        inset 0 0 25px rgba(0,255,65,.04),
        0 0 20px rgba(0,255,65,.05);
    }

    .submit:disabled {
      opacity: .45;
      cursor: wait;
    }

    .error {
      display: none;
      margin-top: 10px;
      padding: 9px 11px;
      border: 1px solid rgba(255,98,98,.35);
      color: var(--danger);
      font-size: 12px;
      line-height: 1.5;
    }

    /* STATUS STRIP */

    .status-strip {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      border-bottom: 1px solid var(--line);
    }

    .status-item {
      min-height: 43px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 10px;
      color: var(--muted);
      font-size: 13px;
      text-transform: uppercase;
    }

    .status-item + .status-item {
      border-left: 1px solid var(--line);
    }

    .status-mark {
      color: var(--green);
    }

    /* FLOW */

    .flow {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      margin-top: 25px;
      border: 1px solid var(--line-soft);
    }

    .flow-item {
      position: relative;
      padding: 14px 15px;
      min-height: 63px;
    }

    .flow-item + .flow-item {
      border-left: 1px solid var(--line-soft);
    }

    .flow-num {
      display: block;
      margin-bottom: 7px;
      color: var(--green-dim);
      font-size: 13px;
    }

    .flow-name {
      color: #98a49b;
      font-size: 13px;
      text-transform: uppercase;
    }

    /* FOOTER */

    footer {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      padding: 17px 0 25px;
      color: #3f5144;
      font-size: 13px;
      text-transform: uppercase;
    }

    footer strong {
      color: var(--green-dim);
      font-weight: 500;
    }

    @media (max-width: 780px) {
      .shell {
        width: min(100% - 24px, 1160px);
      }

      header {
        padding-top: 12px;
      }

      .nav {
        padding: 0 13px;
      }

      .nav-right > span:first-child {
        display: none;
      }

      main {
        padding-top: 25px;
      }

      .hero {
        grid-template-columns: 1fr;
        gap: 18px;
      }

      h1 {
        font-size: 38px;
      }

      .workspace {
        grid-template-columns: 1fr;
      }

      .step-column {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-right: 0;
        border-bottom: 1px solid var(--line);
      }

      .step-number {
        margin: 0;
      }

      .form-grid {
        grid-template-columns: 1fr;
      }

      .status-strip,
      .flow {
        grid-template-columns: 1fr;
      }

      .status-item + .status-item,
      .flow-item + .flow-item {
        border-left: 0;
        border-top: 1px solid var(--line-soft);
      }

      footer {
        flex-direction: column;
      }
    }
  </style>
</head>

<body>

  <header class="shell">
    <div class="nav">
      <div class="brand">
        ./cipherdrop<span class="cursor"></span>
      </div>

      <div class="nav-right">
        <span>Private digital handoff</span>

        <span class="network">
          <span class="network-dot"></span>
          Zcash Testnet
        </span>
      </div>
    </div>
  </header>

  <main class="shell">

    <div class="section-label">
      // encrypted digital handoff
    </div>

    <section class="hero">
      <h1>
        Secrets.<br>
        <span>Unlocked privately.</span>
      </h1>

      <div class="hero-copy">
        <span class="hero-code">
          // powered by shielded zcash
        </span>

        Create encrypted, paywalled secrets unlocked by
        <strong>shielded ZEC payments</strong>.
        No buyer account. No email. No identity required.
      </div>
    </section>

    <section class="workspace">

      <aside class="step-column">
        <div class="step-number">01</div>

        <div class="step-label">
          Create drop
          <span>Encrypt before storage</span>
        </div>
      </aside>

      <div class="form-area">

        <div class="form-top">
          <div class="form-title">
            // create private drop
          </div>

          <div class="encrypted">
            AES-256-GCM
          </div>
        </div>

        <div class="form-grid">

          <div>
            <div class="field">
              <div class="field-head">
                <span class="field-label">
                  Secret payload
                </span>

                <span class="field-meta">
                  Ciphertext at rest
                </span>
              </div>

              <textarea
                id="secret"
                placeholder="> enter secret payload..."
                spellcheck="false"
              ></textarea>
            </div>
          </div>

          <div class="side-controls">

            <div class="field">
              <div class="field-head">
                <span class="field-label">
                  Unlock price
                </span>

                <span class="field-meta">
                  Max 8 decimals
                </span>
              </div>

              <div class="price-wrap">
                <input
                  id="amount"
                  type="number"
                  min="0"
                  step="0.00000001"
                  placeholder="0.001"
                >

                <span class="currency">
                  ZEC
                </span>
              </div>
            </div>

            <label class="burn-option">
              <input id="burn" type="checkbox">

              <span>
                <span class="burn-title">
                  Burn after first unlock
                </span>

                <span class="burn-desc">
                  Destroy the server-side key after the
                  first successful unlock.
                </span>
              </span>
            </label>

            <button
              id="create"
              class="submit"
              type="button"
            >
              Create encrypted drop
            </button>

            <div id="error" class="error"></div>

          </div>
        </div>
      </div>
    </section>

    <section class="status-strip">
      <div class="status-item">
        <span class="status-mark">◆</span>
        AES-256-GCM encrypted
      </div>

      <div class="status-item">
        <span class="status-mark">◆</span>
        Shielded Zcash payment
      </div>

      <div class="status-item">
        <span class="status-mark">◆</span>
        No buyer account
      </div>
    </section>

    <section class="flow">
      <div class="flow-item">
        <span class="flow-num">01 //</span>
        <span class="flow-name">Encrypt</span>
      </div>

      <div class="flow-item">
        <span class="flow-num">02 //</span>
        <span class="flow-name">Share drop</span>
      </div>

      <div class="flow-item">
        <span class="flow-num">03 //</span>
        <span class="flow-name">Shielded payment</span>
      </div>

      <div class="flow-item">
        <span class="flow-num">04 //</span>
        <span class="flow-name">Private unlock</span>
      </div>
    </section>

    <footer>
      <span>
        CipherDrop // Private digital handoff
      </span>

      <span>
        <strong>Built for Zecathon</strong>
        // Zcash Testnet
      </span>
    </footer>

  </main>

  <script>
    const createButton = document.querySelector('#create');
    const errorBox = document.querySelector('#error');

    createButton.addEventListener('click', async () => {
      const secret = document.querySelector('#secret').value;
      const amount = document.querySelector('#amount').value;
      const burnAfterUnlock = document.querySelector('#burn').checked;

      errorBox.style.display = 'none';
      errorBox.textContent = '';

      if (!secret.trim()) {
        errorBox.textContent =
          '> ERROR: enter a secret payload.';
        errorBox.style.display = 'block';
        return;
      }

      if (!amount || Number(amount) <= 0) {
        errorBox.textContent =
          '> ERROR: enter a valid ZEC unlock price.';
        errorBox.style.display = 'block';
        return;
      }

      createButton.disabled = true;
      createButton.textContent = 'Encrypting...';

      try {
        const response = await fetch('/api/drops', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            secret,
            amount,
            burnAfterUnlock
          })
        });

        const result = await response.json();

        if (!response.ok) {
          throw new Error(
            result.error ||
            result.message ||
            'Unable to create encrypted drop.'
          );
        }

        if (!result.drop || !result.drop.id) {
          throw new Error(
            'Server returned an invalid drop.'
          );
        }

        location.href = '/drop/' + result.drop.id;

      } catch (error) {
        errorBox.textContent =
          '> ERROR: ' + error.message;

        errorBox.style.display = 'block';

        createButton.disabled = false;
        createButton.textContent =
          'Create encrypted drop';
      }
    });
  </script>

</body>
</html>


